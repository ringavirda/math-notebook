{
  "name": "@mathbook/storage-sqlite",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit && tsc -p test && tsc -p tsconfig.config.json",
    "test": "vitest run",
    "clean": "rimraf dist",
    "generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@mathbook/common": "workspace:*",
    "@mathbook/notebook": "workspace:*",
    "better-sqlite3": "catalog:",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@mathbook/hosting": "workspace:*",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
